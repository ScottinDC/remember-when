# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in hosted Edge Functions.
# Local development reads these values from a private, untracked supabase/functions/.env file.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
SENDGRID_API_KEY=
DIGEST_FROM_EMAIL=
DIGEST_FROM_NAME=Remember When
DIGEST_TIMEZONE=America/Los_Angeles
# High-entropy secret shared only by the scheduled database call and this function.
DIGEST_SCHEDULE_SECRET=
