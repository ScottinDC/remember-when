{
  "name": "remember-when",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run client",
    "client": "vite --host",
    "build": "tsc && vite build",
    "build:netlify": "npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --project=production",
    "test:e2e:local": "playwright test --project=local",
    "test:e2e:headed": "playwright test --headed",
    "preview:netlify": "npx netlify dev",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "check": "npm run test:unit && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@vitejs/plugin-react": "^4.3.4",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/luxon": "^3.7.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
